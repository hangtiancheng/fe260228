{
  "packageManager": "pnpm@12.10.1",
  "dependencies": {
    "dayjs": "^1.11.23",
    "md5": "^2.3.0"
  },
  "devDependencies": {
    "@types/md5": "^2.3.6",
    "concurrently": "^9.2.5",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.7.4"
  },
  "scripts": {
    "client:dev": "pnpm --filter client dev",
    "server:dev": "pnpm --filter server dev",
    "dev": "concurrently \"pnpm client:dev\" \"pnpm server:dev\"",
    "client:format": "pnpm --filter client format",
    "server:format": "pnpm --filter server format",
    "format": "concurrently \"pnpm client:format\" \"pnpm server:format\"",
    "client:build": "pnpm --filter client build",
    "server:build": "pnpm --filter server build",
    "build": "concurrently \"pnpm client:build\" \"pnpm server:build\"",
